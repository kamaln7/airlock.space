[Unit]
Description=airlock.space SSH APOD server
Requires=airlocksshd.socket

[Service]
ExecStart=/opt/airlocksshd
NonBlocking=true
DynamicUser=yes
StateDirectory=airlocksshd
WorkingDirectory=/var/lib/airlocksshd
Environment=SSH_HOST_KEY=/var/lib/airlocksshd/id_ed25519
# NASAKEY lives here, 0600 root, so it stays out of the unit and out of logs
EnvironmentFile=/etc/airlocksshd.env
Restart=always
RestartSec=1s
# the box is dedicated to this, so no hard MemoryMax: a kill mid-render is
# worse than using the RAM. MemoryHigh only throttles/reclaims, leaving room
# for sshd on the 457MB box
MemoryHigh=350M
